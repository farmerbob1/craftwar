# ===== Unity standard =====
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Asset store tools
/[Aa]ssets/AssetStoreTools*

# Autogenerated JetBrains Rider plugin
/[Aa]ssets/Plugins/Editor/JetBrains*

# Visual Studio / Rider caches
.vs/
.idea/
.vsconfig
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files for deleted assets
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Crash reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics
crashlytics-build.properties

# Test results
/[Tt]est[Rr]esults/
*.xml.meta
TestResults.xml

# ===== Craftwar: Blizzard-owned data must NEVER be committed =====
# Extracted asset cache (sprites/tiles/sounds decoded from original game data)
/Assets/GameData/Extracted/
/Assets/GameData/Extracted.meta
# Original maps (Blizzard .pud files). Custom self-made maps go in a
# separate folder and are committed explicitly.
/Assets/StreamingAssets/Maps/*.pud
/Assets/StreamingAssets/Maps/*.pud.meta
# Original game archives, wherever they end up
*.war
*.mpq
*.sud
# Per-machine pointer to the local WC2 install / maindat.war
LocalAssetPaths.json

/* Shared primitives. Colors come exclusively from var(--cw-*) so a theme
   swap needs no edits here. */

.panel {
    /* Recessed fill, not the same near-black as the surrounding .menu —
       otherwise an empty scroll box reads as a void with a faint outline
       rather than a distinct content area. */
    background-color: var(--cw-panel-bg-inset);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--cw-panel-border);
    border-right-color: var(--cw-panel-border);
    border-top-color: var(--cw-panel-border);
    border-bottom-color: var(--cw-panel-border);
    border-radius: 3px;
}

.text {
    color: var(--cw-text);
    font-size: 13px;
}

.text--dim {
    color: var(--cw-text-dim);
}

.text--warn {
    color: var(--cw-warn);
}

/* Generic progress/HP bar: a track with a fill whose width is set from C#. */
.bar {
    height: 6px;
    background-color: rgb(18, 19, 22);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--cw-panel-border);
    border-right-color: var(--cw-panel-border);
    border-top-color: var(--cw-panel-border);
    border-bottom-color: var(--cw-panel-border);
}

.bar__fill {
    height: 100%;
    width: 100%;
    background-color: var(--cw-hp-high);
}

.bar__fill--mid {
    background-color: var(--cw-hp-mid);
}

.bar__fill--low {
    background-color: var(--cw-hp-low);
}

.bar__fill--mana {
    background-color: var(--cw-mana);
}

/* TextField (and other BaseField controls) come from Unity's own default
   runtime theme with no color override — its caption/typed-text color reads
   as near-black, which disappears against our near-black --cw-panel-bg-solid
   panels. Explicit contrast here, not just inheritance, since the default
   theme sets color directly on these same classes (same-specificity import
   order is what actually wins — see ThemeDark.tss). */
.unity-base-field__label {
    color: var(--cw-text);
}

.unity-base-text-field__input {
    background-color: rgb(15, 16, 19);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--cw-panel-border);
    border-right-color: var(--cw-panel-border);
    border-top-color: var(--cw-panel-border);
    border-bottom-color: var(--cw-panel-border);
    border-radius: 3px;
}

.unity-base-text-field__input .unity-text-element,
TextField .unity-text-element {
    color: var(--cw-text);
}

/* DropdownField (status/race/team pickers): same default-theme mismatch as
   TextField above, plus BaseField always builds a caption Label even when
   no label text is set — the default theme reserves real width for it
   (sized for two-column Inspector rows), which is what ate almost the whole
   box down to 3-4 visible characters. The label is hidden per-instance in
   C# (labelElement.style.display = None) since only OUR dropdowns are
   label-less; this just re-themes what's left to match the dark panel. */
.unity-base-popup-field__input {
    background-color: var(--cw-btn-bg);
    padding-left: 4px;
    padding-right: 2px;
    padding-top: 2px;
    padding-bottom: 2px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--cw-panel-border);
    border-right-color: var(--cw-panel-border);
    border-top-color: var(--cw-panel-border);
    border-bottom-color: var(--cw-panel-border);
    border-radius: 3px;
}

.unity-base-popup-field__text {
    color: var(--cw-text);
}

.unity-base-popup-field__input:hover,
.unity-base-popup-field__input.unity-base-popup-field__input:hover {
    background-color: var(--cw-btn-bg-hover);
}

/* The dropdown's OPEN item list (GenericDropdownMenu) is a separate runtime
   overlay that only picks up the default theme's own colors unless we
   target its classes directly — it was rendering with a stock white/near-
   white hover highlight behind text we never explicitly darkened, so a
   hovered row was unreadable. Force dark chrome + light text to match the
   rest of the panel. */
.unity-base-dropdown {
    background-color: var(--cw-panel-bg-solid);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--cw-panel-border);
    border-right-color: var(--cw-panel-border);
    border-top-color: var(--cw-panel-border);
    border-bottom-color: var(--cw-panel-border);
}

.unity-base-dropdown__item {
    color: var(--cw-text);
}

.unity-base-dropdown__label,
.unity-base-dropdown__checkmark {
    color: var(--cw-text);
}

.unity-base-dropdown__item:hover,
.unity-base-dropdown__item.unity-base-dropdown__item:hover {
    background-color: var(--cw-btn-bg-hover);
    color: var(--cw-text);
}

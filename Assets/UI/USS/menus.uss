/* Screen-stack menus (pause menu at phase 6, main menu / match setup at M8).
   Intentionally minimal until then — the theme vars are already in place. */

.screen-scrim {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.55);
    align-items: center;
    justify-content: center;
}

.menu {
    width: 320px;
    padding: 20px;
    background-color: var(--cw-panel-bg-solid);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--cw-panel-border);
    border-right-color: var(--cw-panel-border);
    border-top-color: var(--cw-panel-border);
    border-bottom-color: var(--cw-panel-border);
}

/* Panels whose rows are wide (skirmish setup: label + controller + race +
   strategy + difficulty per slot). */
.menu--wide {
    width: 640px;
}

.menu__title {
    color: var(--cw-accent);
    font-size: 20px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 16px;
}

.menu__button {
    height: 36px;
    margin-bottom: 8px;
    color: var(--cw-text);
    font-size: 14px;
    background-color: var(--cw-btn-bg);
    border-left-color: var(--cw-panel-border);
    border-right-color: var(--cw-panel-border);
    border-top-color: var(--cw-panel-border);
    border-bottom-color: var(--cw-panel-border);
}

.menu__button:hover {
    background-color: var(--cw-btn-bg-hover);
}

.menu__button:disabled {
    color: var(--cw-text-dim);
    background-color: var(--cw-btn-bg-disabled);
}

/* --- options screen --- */

.options-tabs {
    flex-direction: row;
    margin-bottom: 12px;
}

/* Tabs share the row; the selected one is the one you cannot press. */
.options-tab {
    flex-grow: 1;
    margin-right: 4px;
    margin-bottom: 0;
}

.options-tab:disabled {
    color: var(--cw-accent);
    background-color: var(--cw-btn-bg-hover);
}

.options-row {
    flex-direction: row;
    align-items: center;
    height: 30px;
    margin-bottom: 6px;
}

.options-row__label {
    width: 80px;
    color: var(--cw-text);
    font-size: 13px;
}

.options-row__slider {
    flex-grow: 1;
    margin-right: 8px;
}

.options-row__value {
    width: 44px;
    color: var(--cw-text-dim);
    font-size: 12px;
    -unity-text-align: middle-right;
}

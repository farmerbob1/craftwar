<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <!-- Cloned 9x into the command card and never re-created; activation is a
         click or the command's WC2 shortcut letter. The icon IS the button: it
         fills the cell edge to edge, with only the hotkey letter over it. Name
         and cost go to the status line under the card while hovered. -->
    <ui:VisualElement class="command-button">
        <ui:Label name="icon" class="command-button__icon" text="?" picking-mode="Ignore" />
        <ui:Label name="key" class="command-button__key" text="Q" picking-mode="Ignore" />
    </ui:VisualElement>
</ui:UXML>

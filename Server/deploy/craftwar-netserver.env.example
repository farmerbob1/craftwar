# Copy to /etc/craftwar/craftwar-netserver.env (referenced by
# craftwar-netserver.service's EnvironmentFile) and fill in real values.
# Keep permissions tight (chmod 600, owned by the service user) — this file
# holds the TLS private key password.

CRAFTWAR_HOST=0.0.0.0
CRAFTWAR_PORT=27015
CRAFTWAR_DB_PATH=/var/lib/craftwar-netserver/craftwar.db

# CertificateProvider auto-generates/caches a self-signed cert at whatever
# path this points to if the file doesn't exist yet — fine for "running it
# myself for now". It must still be a WRITABLE path though: the shipped
# .service hardens with ProtectSystem=strict, which makes everything
# read-only except ReadWritePaths (/var/lib/craftwar-netserver below) — do
# NOT leave this blank, since that falls back to a path relative to
# WorkingDirectory (/opt/craftwar-netserver), which is read-only under that
# hardening and the service will fail to start on first run. Once real
# players connect, point this at a real PFX instead (e.g. exported from a
# Let's Encrypt cert via `openssl pkcs12 -export ...`) — same writable
# directory, just a real file instead of the auto-generated one.
CRAFTWAR_CERT_PATH=/var/lib/craftwar-netserver/craftwar-cert.pfx
CRAFTWAR_CERT_PASSWORD=
